MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9fa1058a81e33544bb6257c041c318a5, type: 3}
  m_Name: Octo
  m_EditorClassIdentifier: Assembly-CSharp::NPCData
  nombreNPC: Octo
  imageNPC: {fileID: 21300000, guid: c3da2e82ba298fe4abe1b2916bf1e849, type: 3}
  fondoImagenNPC: {fileID: 21300000, guid: 9f57495d53c489346865613810fd9e69, type: 3}
  fondoTexto: {fileID: 21300000, guid: fcfba45733944b9469d043250b3a61ee, type: 3}
  sonidoVoz: {fileID: 8300000, guid: d453f1d7b5f032a48bbb6c64a728caef, type: 3}
  pitchVoz: 1.466
  dialogos:
  - texto: "Ser\xE1n buenos d\xEDas para ti. Yo estuve ocupado."
    duracion: 4
    iconoTutorial: {fileID: 0}
  - texto: Dormir es para cuando termine el trabajo.
    duracion: 4
    iconoTutorial: {fileID: 0}
  - texto: No empieces.
    duracion: 4
    iconoTutorial: {fileID: 0}
  - texto: Habla.
    duracion: 4
    iconoTutorial: {fileID: 0}
  - texto: Eso no ha cambiado.
    duracion: 4
    iconoTutorial: {fileID: 0}
  - texto: Bien.
    duracion: 4
    iconoTutorial: {fileID: 0}
  - texto: Sigue hablando.
    duracion: 4
    iconoTutorial: {fileID: 0}
  - texto: "Al menos alguien entendi\xF3 que una nave debe ir r\xE1pido."
    duracion: 4
    iconoTutorial: {fileID: 0}
  - texto: "\xBFY si no esquivo?"
    duracion: 4
    iconoTutorial: {fileID: 0}
  - texto: Anotado.
    duracion: 4
    iconoTutorial: {fileID: 0}
  - texto: "Contin\xFAa."
    duracion: 4
    iconoTutorial: {fileID: 0}
  - texto: Mismo color. Absorbo.
    duracion: 4
    iconoTutorial: {fileID: 0}
  - texto: He sobrevivido a cosas peores.
    duracion: 4
    iconoTutorial: {fileID: 0}
  - texto: Blanco contra negro. Negro contra blanco.
    duracion: 4
    iconoTutorial: {fileID: 0}
  - texto: "Eso s\xED lo recuerdo."
    duracion: 4
    iconoTutorial: {fileID: 0}
  - texto: "\xBFResultado?"
    duracion: 4
    iconoTutorial: {fileID: 0}
  - texto: Entendido.
    duracion: 4
    iconoTutorial: {fileID: 0}
  - texto: "Entonces el color correcto tambi\xE9n decide por d\xF3nde puedo pasar."
    duracion: 4
    iconoTutorial: {fileID: 0}
  - texto: "\xBFMunici\xF3n?"
    duracion: 4
    iconoTutorial: {fileID: 0}
  - texto: "\xBFY sin munici\xF3n?"
    duracion: 4
    iconoTutorial: {fileID: 0}
  - texto: Entonces no la desperdicio.
    duracion: 4
    iconoTutorial: {fileID: 0}
  - texto: Nunca tuve problemas con eso.
    duracion: 4
    iconoTutorial: {fileID: 0}
  - texto: No soy suicida.
    duracion: 4
    iconoTutorial: {fileID: 0}
  - texto: "Tres cargas. Las guardar\xE9."
    duracion: 4
    iconoTutorial: {fileID: 0}
  - texto: J0I.
    duracion: 4
    iconoTutorial: {fileID: 0}
  - texto: Ponme algo que pueda matar.
    duracion: 4
    iconoTutorial: {fileID: 0}
