%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9fa1058a81e33544bb6257c041c318a5, type: 3}
  m_Name: J0i
  m_EditorClassIdentifier: Assembly-CSharp::NPCData
  nombreNPC: J0I
  imageNPC: {fileID: -6368692178082650430, guid: 7a6d303afebc43943a8319120c8afed7, type: 3}
  fondoImagenNPC: {fileID: 21300000, guid: 709aa6bf33ee128419f61525a65e36c5, type: 3}
  fondoTexto: {fileID: 21300000, guid: 25f917c38401d0749826579382d1d97a, type: 3}
  sonidoVoz: {fileID: 8300000, guid: a81e76b2c894ed04499c4575583a7d78, type: 3}
  pitchVoz: 1.255
  dialogos:
  - texto: "Heeey, buenos d\xEDas. \xBFListo para otro d\xEDa lleno de situaciones
      que nos pueden quitar la vida?"
    duracion: 4
    iconoTutorial: {fileID: 0}
  - texto: "\xBFOtra noche sin dormir?"
    duracion: 4
    iconoTutorial: {fileID: 0}
  - texto: "Claro. Y beber hasta perder el conocimiento es tu forma de celebrar,
      \xBFno?"
    duracion: 4
    iconoTutorial: {fileID: 0}
  - texto: "Bien. S\xE9 que llevas m\xE1s a\xF1os pilotando de los que quieres admitir,
      pero hice algunas mejoras a la nave. Conviene que sepas qu\xE9 hacen."
    duracion: 5
    iconoTutorial: {fileID: 0}
  - texto: "Movimiento b\xE1sico. Joystick izquierdo para dirigir la nave."
    duracion: 4
    iconoTutorial: {fileID: -3278349181384251914, guid: 3d768c22140a01744941fea0e806d02a, type: 3}
  - texto: "Puedes desplazarte libremente en cualquier direcci\xF3n."
    duracion: 4
    iconoTutorial: {fileID: 0}
  - texto: No. Intento no arruinar lo que funciona.
    duracion: 4
    iconoTutorial: {fileID: 0}
  - texto: "Joystick derecho para apuntar. Puedes moverte en una direcci\xF3n y disparar
      hacia otra."
    duracion: 4
    iconoTutorial: {fileID: 2143550986, guid: 3d768c22140a01744941fea0e806d02a, type: 3}
  - texto: RT dispara el arma principal.
    duracion: 4
    iconoTutorial: {fileID: 1924095763, guid: f09709f2ed00639489202339881330f7, type: 3}
  - texto: "\xBFEso fue un \"bien\" o est\xE1s emocionalmente afectado?"
    duracion: 4
    iconoTutorial: {fileID: 0}
  - texto: "X reduce la velocidad. \xDAtil para maniobras precisas."
    duracion: 4
    iconoTutorial: {fileID: 410893291, guid: 3d768c22140a01744941fea0e806d02a, type: 3}
  - texto: "B activa el boost. \xDAsalo para acelerar r\xE1pidamente."
    duracion: 4
    iconoTutorial: {fileID: 792870536, guid: 3d768c22140a01744941fea0e806d02a, type: 3}
  - texto: "Tambi\xE9n entend\xED que normalmente intentas ir m\xE1s r\xE1pido de
      lo necesario."
    duracion: 4
    iconoTutorial: {fileID: 0}
  - texto: 'Para maniobras evasivas: RB hace dash a la derecha.'
    duracion: 4
    iconoTutorial: {fileID: 1242865998, guid: 3d768c22140a01744941fea0e806d02a, type: 3}
  - texto: Y LB para el dash hacia la izquierda
    duracion: 4
    iconoTutorial: {fileID: -820816641, guid: 3d768c22140a01744941fea0e806d02a, type: 3}
  - texto: "\xDAsalos para esquivar fuego enemigo o reposicionarte."
    duracion: 4
    iconoTutorial: {fileID: 0}
  - texto: "Entonces tendr\xE1s una conversaci\xF3n mucho m\xE1s corta conmigo."
    duracion: 4
    iconoTutorial: {fileID: 0}
  - texto: "Ahora la modificaci\xF3n importante."
    duracion: 4
    iconoTutorial: {fileID: 0}
  - texto: Pulsa A para alternar entre blanco y negro.
    duracion: 4
    iconoTutorial: {fileID: 422804783, guid: 3d768c22140a01744941fea0e806d02a, type: 3}
  - texto: "No es pintura. El color determina c\xF3mo interact\xFAas con la energ\xEDa."
    duracion: 4
    iconoTutorial: {fileID: 0}
  - texto: "Mientras seas blanco, los proyectiles blancos no pueden da\xF1arte. Los
      absorbes y esa energ\xEDa carga tu ataque especial."
    duracion: 4
    iconoTutorial: {fileID: 0}
  - texto: En negro, ocurre lo mismo con los proyectiles negros.
    duracion: 4
    iconoTutorial: {fileID: 0}
  - texto: Exacto. Si no quieres morir, recuerda esa parte.
    duracion: 4
    iconoTutorial: {fileID: 0}
  - texto: "Por eso todav\xEDa tengo trabajo."
    duracion: 4
    iconoTutorial: {fileID: 0}
  - texto: "El color tambi\xE9n afecta tu armamento."
    duracion: 4
    iconoTutorial: {fileID: 0}
  - texto: "Disparar a un enemigo de color opuesto causa el doble de da\xF1o."
    duracion: 4
    iconoTutorial: {fileID: 0}
  - texto: Correcto.
    duracion: 4
    iconoTutorial: {fileID: 0}
  - texto: "Y cuidado con los objetos de energ\xEDa."
    duracion: 4
    iconoTutorial: {fileID: 0}
  - texto: Una nave blanca no puede atravesar una barrera negra. Una nave negra no
      puede atravesar una barrera blanca.
    duracion: 4
    iconoTutorial: {fileID: 0}
  - texto: "Destrucci\xF3n instant\xE1nea."
    duracion: 4
    iconoTutorial: {fileID: 0}
  - texto: "No son solamente paredes. Puede ser un rayo, un campo de energ\xEDa o
      cualquier obst\xE1culo que utilice esta tecnolog\xEDa"
    duracion: 4
    iconoTutorial: {fileID: 0}
  - texto: Exactamente.
    duracion: 4
    iconoTutorial: {fileID: 0}
  - texto: "\xDAltima modificaci\xF3n. LT activa el ca\xF1\xF3n cargado."
    duracion: 4
    iconoTutorial: {fileID: 1349566971, guid: 3d768c22140a01744941fea0e806d02a, type: 3}
  - texto: "Especial. Tienes un m\xE1ximo de tres cargas y debes recoger munici\xF3n
      para recuperarlas"
    duracion: 4
    iconoTutorial: {fileID: 0}
  - texto: LT no dispara.
    duracion: 4
    iconoTutorial: {fileID: 0}
  - texto: Eso espero.
    duracion: 4
    iconoTutorial: {fileID: 0}
  - texto: Muy bien. Vamos a comprobar que sigues teniendo memoria.
    duracion: 4
    iconoTutorial: {fileID: 0}
  - texto: "Curiosamente, s\xED con seguir instrucciones."
    duracion: 4
    iconoTutorial: {fileID: 0}
  - texto: "Mu\xE9vete con el joystick izquierdo."
    duracion: 4
    iconoTutorial: {fileID: -3278349181384251914, guid: 3d768c22140a01744941fea0e806d02a, type: 3}
  - texto: Apunta con el derecho. RT para disparar.
    duracion: 4
    iconoTutorial: {fileID: 1924095763, guid: f09709f2ed00639489202339881330f7, type: 3}
  - texto: Ahora cambia de color. Absorbe los proyectiles del mismo color y ataca
      a los enemigos del color opuesto.
    duracion: 5
    iconoTutorial: {fileID: 422804783, guid: 3d768c22140a01744941fea0e806d02a, type: 3}
  - texto: Y recuerda las barreras.
    duracion: 4
    iconoTutorial: {fileID: 422804783, guid: 3d768c22140a01744941fea0e806d02a, type: 3}
  - texto: Eso es debatible.
    duracion: 4
    iconoTutorial: {fileID: 0}
  - texto: "Ah\xED tienes munici\xF3n para el ca\xF1\xF3n."
    duracion: 4
    iconoTutorial: {fileID: 1349566971, guid: 3d768c22140a01744941fea0e806d02a, type: 3}
  - texto: Sorprendente.
    duracion: 4
    iconoTutorial: {fileID: 0}
  - texto: "\xBFS\xED Octo?"
    duracion: 4
    iconoTutorial: {fileID: 0}
  - texto: Como diga capitan.
    duracion: 4
    iconoTutorial: {fileID: 0}
